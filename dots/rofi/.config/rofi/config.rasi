configuration{
    modi: "run,window,combi";
    icon-theme: "Gruvbox-Dark";
    show-icons: true;
    terminal: "alacritty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-combi: " 🖥️  All ";
    display-run: " 󰜎 Run ";
    display-window: " 󱂬  Window";
    sidebar-mode: true;
    drun-match-fields: "name,generic,exec,categories,keywords";
} 

@theme "~/.config/rofi/themes/gruvbox.rasi"


